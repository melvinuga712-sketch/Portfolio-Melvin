const typingElement = document.querySelector(".hero-text h2");

const typingTexts = [
    "Student | Web Developer | Designer",
    "Creative Digital Enthusiast",
    "Technology Enthusiast",
    "Future Web Developer"
];

let textIndex = 0;
let charIndex = 0;
let deleting = false;

function typingEffect() {
    const currentText = typingTexts[textIndex];

    if (!deleting) {
        typingElement.textContent = currentText.substring(0, charIndex + 1);
        charIndex++;

        if (charIndex === currentText.length) {
            deleting = true;
            setTimeout(typingEffect, 1500);
            return;
        }
    } else {
        typingElement.textContent = currentText.substring(0, charIndex - 1);
        charIndex--;

        if (charIndex === 0) {
            deleting = false;
            textIndex++;

            if (textIndex >= typingTexts.length) {
                textIndex = 0;
            }
        }
    }

    setTimeout(typingEffect, deleting ? 50 : 80);
}

typingEffect();
